DATABASE_URL=postgres://worklog:worklog@localhost:5432/worklog?sslmode=disable
PORT=8080
BASE_URL=http://localhost:8080

# GitHub App user authorization. These are separate from the App ID/private
# key used for installation access and webhooks.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Leave endpoint overrides empty for ordinary GitHub.com use. A disposable
# local provider can set them when running the integration verification.
GITHUB_AUTHORIZATION_URL=
GITHUB_TOKEN_URL=
GITHUB_INSTALLATION_URL=
GITHUB_API_URL=

# GitHub App installation access and webhook verification.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Required by `serve` when BASE_URL uses HTTPS. HTTP localhost may use the log
# mailer while developing.
RESEND_API_KEY=
MAIL_FROM=

# Direct local API runs have no trusted proxy. Compose derives this from its
# fixed Caddy address instead.
TRUSTED_PROXY_CIDRS=
