# Copy to .env.local (git-ignored) and fill in real values.
# Never commit a filled-in copy of this file.

# --- Public address -------------------------------------------------------
# The hostname Caddy serves. Use "http://localhost" locally; use a bare
# hostname such as "worklog.example.com" in production so Caddy provisions a
# Let's Encrypt certificate automatically.
SITE_ADDRESS=
# The origin the API builds absolute links and OAuth callbacks from.
BASE_URL=

# Host ports Caddy binds. Override only if 80/443 are already taken.
HTTP_PORT=80
HTTPS_PORT=443
# The ports Caddy listens on INSIDE the container. These are derived from
# SITE_ADDRESS: a bare hostname means 80 and 443, but an address carrying an
# explicit port, such as http://localhost:8088, means Caddy listens on that
# port instead and these must match it.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Private proxy network -------------------------------------------------
# These defaults match docker-compose.yml. For multiple stacks on one host,
# choose a non-overlapping subnet and keep both fixed addresses inside it.
PROXY_SUBNET=172.30.75.0/24
PROXY_CADDY_IP=172.30.75.2
PROXY_API_IP=172.30.75.3

# --- Database -------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=worklog
# Must match the three values above; the host is the compose service name.
DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/worklog?sslmode=disable

# --- Mail (required for HTTPS) ---------------------------------------------
# `serve` refuses HTTPS startup without both values. HTTP localhost may leave
# them blank and uses the log mailer for local sign-in verification.
RESEND_API_KEY=
MAIL_FROM=

# --- GitHub App user authorization (answers "which human is this") --------
# These credentials belong to the GitHub App's user-authorization settings.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Leave endpoint overrides empty for ordinary GitHub.com use. A disposable
# local provider can set them when running the integration verification.
GITHUB_AUTHORIZATION_URL=
GITHUB_TOKEN_URL=
GITHUB_INSTALLATION_URL=

# --- GitHub App (webhooks and repository reads) ---------------------------
GITHUB_APP_ID=
# The PEM contents of the App's private key, newlines included, quoted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Leave empty for github.com. Set it for GitHub Enterprise, e.g.
# https://github.example.com/api/v3
GITHUB_API_URL=

# --- Backups (optional) ---------------------------------------------------
# Destination passed to the AWS CLI, e.g. s3://my-bucket/worklog. Unset means
# dumps stay on local disk only.
BACKUP_S3_URL=
