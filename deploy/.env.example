# Copy to .env.local (git-ignored) and fill in real values.
# Never commit a filled-in copy of this file.

# --- Public address -------------------------------------------------------
# The hostname Caddy serves. Use "http://localhost" locally; use a bare
# hostname such as "worklog.example.com" in production so Caddy provisions a
# Let's Encrypt certificate automatically.
SITE_ADDRESS=
# The origin the API builds absolute links and OAuth callbacks from.
BASE_URL=

# Host ports Caddy binds. Override only if 80/443 are already taken.
HTTP_PORT=80
HTTPS_PORT=443
# The ports Caddy listens on INSIDE the container. These are derived from
# SITE_ADDRESS: a bare hostname means 80 and 443, but an address carrying an
# explicit port, such as http://localhost:8088, means Caddy listens on that
# port instead and these must match it.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Database -------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=worklog
# Must match the three values above; the host is the compose service name.
DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/worklog?sslmode=disable

# --- Sessions -------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- GitHub OAuth app (answers "which human is this") ---------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App (webhooks and repository reads) ---------------------------
GITHUB_APP_ID=
# The PEM contents of the App's private key, newlines included, quoted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Backups (optional) ---------------------------------------------------
# Destination passed to the AWS CLI, e.g. s3://my-bucket/worklog. Unset means
# dumps stay on local disk only.
BACKUP_S3_URL=
