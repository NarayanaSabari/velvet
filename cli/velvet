#!/usr/bin/env bash
# A small, dependency-light CLI for writing Velvet work-log entries.

set -euo pipefail

readonly EX_USAGE=2
readonly EX_AUTH=3
readonly EX_NOT_FOUND=4
readonly EX_NETWORK=5
readonly EX_API=6
readonly EX_CONFIG=78

BASE_URL=""
API_ROOT=""
TMP_DIR=""
HTTP_STATUS=""

cleanup() {
  if [ -n "${TMP_DIR:-}" ] && [ -d "$TMP_DIR" ]; then
    rm -rf "$TMP_DIR"
  fi
}
trap cleanup EXIT HUP INT TERM

die() {
  local message=$1
  local code=${2:-$EX_USAGE}
  printf 'velvet: %s\n' "$message" >&2
  exit "$code"
}

require_command() {
  local command_name=$1
  command -v "$command_name" >/dev/null 2>&1 || die "required command not found: $command_name" "$EX_CONFIG"
}

usage() {
  cat <<'EOF'
Usage: velvet <command> [arguments]

Commands:
  me                                      Check token authentication
  issues [--status STATUS] [--mine]      List issue keys and titles
  issue KEY                              Show an issue and recent comments
  new TITLE [options]                    Create an issue and print its key
  log KEY [BODY ...]                     Append a work-log comment
  status KEY STATUS                      Change an issue status
  key-from-branch                        Extract an issue key from HEAD

Run 'velvet <command> --help' for command details.

Environment:
  VELVET_URL                              Velvet URL, for example https://worklog.example.com
  VELVET_TOKEN                           Personal token (velvet_...)
  VELVET_WORKSPACE                       Workspace slug, for example engineering
EOF
}

usage_me() {
  cat <<'EOF'
Usage: velvet me

Check the Velvet token and display the authenticated user and memberships.
Requires VELVET_URL and VELVET_TOKEN. VELVET_WORKSPACE is not needed.
EOF
}

usage_issues() {
  cat <<'EOF'
Usage: velvet issues [--status STATUS] [--mine]

List issue keys and titles in VELVET_WORKSPACE.

Options:
  --status STATUS   Filter by backlog, todo, in_progress, in_review, done, or cancelled
  --mine            Show only issues assigned to the authenticated user
  -h, --help        Show this help
EOF
}

usage_issue() {
  cat <<'EOF'
Usage: velvet issue KEY

Show an issue and its ten most recent comments in VELVET_WORKSPACE.

Options:
  -h, --help        Show this help
EOF
}

usage_new() {
  cat <<'EOF'
Usage: velvet new TITLE [options]

Create an issue in VELVET_WORKSPACE and print its generated key.

Options:
  --desc TEXT       Set the issue description
  --status STATUS   Set backlog, todo, in_progress, in_review, done, or cancelled
  --priority N      Set priority from 0 through 4
  --milestone ID    Associate the issue with a milestone UUID
  -h, --help        Show this help
EOF
}

usage_log() {
  cat <<'EOF'
Usage: velvet log KEY [BODY ...]

Append a work-log comment to an issue. If BODY is omitted, read it from stdin.

Options:
  -h, --help        Show this help
EOF
}

usage_status() {
  cat <<'EOF'
Usage: velvet status KEY STATUS

Set an issue status to backlog, todo, in_progress, in_review, done, or cancelled.

Options:
  -h, --help        Show this help
EOF
}

usage_key_from_branch() {
  cat <<'EOF'
Usage: velvet key-from-branch

Extract the first issue key from the current Git branch, such as ENG-42 from
sabari/eng-42-fix-auth. Exit 1 when the branch has no issue key.
EOF
}

valid_status() {
  case "$1" in
    backlog|todo|in_progress|in_review|done|cancelled) return 0 ;;
    *) return 1 ;;
  esac
}

require_base_config() {
  require_command curl
  require_command python3

  if [ -z "${VELVET_URL:-}" ]; then
    die "VELVET_URL is not set; set it to the Velvet server URL" "$EX_CONFIG"
  fi
  if [ -z "${VELVET_TOKEN:-}" ]; then
    die "VELVET_TOKEN is not set; provide a velvet_... personal token" "$EX_CONFIG"
  fi
  case "$VELVET_URL" in
    http://*|https://*) ;;
    *) die "VELVET_URL must start with http:// or https://" "$EX_CONFIG" ;;
  esac

  BASE_URL=${VELVET_URL%/}
  API_ROOT="$BASE_URL/api/v1"
  if [ -z "$TMP_DIR" ]; then
    TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/velvet.XXXXXX") || die "could not create a temporary directory" "$EX_CONFIG"
  fi
}

require_workspace() {
  require_base_config
  if [ -z "${VELVET_WORKSPACE:-}" ]; then
    die "VELVET_WORKSPACE is not set; provide the workspace slug" "$EX_CONFIG"
  fi
}

urlencode() {
  python3 - "$1" <<'PY'
from urllib.parse import quote
import sys

print(quote(sys.argv[1], safe=""))
PY
}

query_param() {
  python3 - "$1" "$2" <<'PY'
from urllib.parse import urlencode
import sys

print(urlencode([(sys.argv[1], sys.argv[2])]))
PY
}

error_message() {
  python3 - "$1" <<'PY'
import json
import sys

path = sys.argv[1]
try:
    raw = open(path, encoding="utf-8").read()
except OSError:
    raw = ""
try:
    data = json.loads(raw)
except json.JSONDecodeError:
    data = None

message = ""
if isinstance(data, dict):
    error = data.get("error")
    if isinstance(error, dict):
        message = error.get("message") or error.get("code") or ""
    elif isinstance(data.get("message"), str):
        message = data["message"]
if not message:
    message = " ".join(raw.split())[:240]
print(message or "the server returned an error")
PY
}

api_error() {
  local status=$1
  local path=$2
  local message
  message=$(error_message "$path")

  case "$status" in
    401)
      die "authentication failed (401): $message. Check VELVET_TOKEN" "$EX_AUTH"
      ;;
    403)
      die "permission denied (403): $message" "$EX_AUTH"
      ;;
    404)
      die "not found (404): $message. Check VELVET_WORKSPACE and the issue key" "$EX_NOT_FOUND"
      ;;
    000)
      die "request failed: $message" "$EX_NETWORK"
      ;;
    *)
      die "Velvet API returned HTTP $status: $message" "$EX_API"
      ;;
  esac
}

request() {
  local method=$1
  local url=$2
  local output=${3:-"$TMP_DIR/response.json"}
  local payload=${4-}
  local curl_status
  local curl_exit
  local curl_error
  local -a curl_args

  curl_args=(
    --silent
    --show-error
    --connect-timeout 10
    --max-time 60
    --request "$method"
    --header "Accept: application/json"
    --header "Authorization: Bearer $VELVET_TOKEN"
    --output "$output"
    --write-out '%{http_code}'
    "$url"
  )
  if [ -n "$payload" ]; then
    curl_args+=(--header "Content-Type: application/json" --data "$payload")
  fi

  if curl_status=$(curl "${curl_args[@]}" 2>"$TMP_DIR/curl.stderr"); then
    curl_exit=0
  else
    curl_exit=$?
  fi
  if [ "$curl_exit" -ne 0 ]; then
    curl_error=$(cat "$TMP_DIR/curl.stderr" 2>/dev/null || true)
    die "request failed: ${curl_error:-curl exited with status $curl_exit}" "$EX_NETWORK"
  fi

  HTTP_STATUS=$curl_status
  case "$HTTP_STATUS" in
    2??) ;;
    *) api_error "$HTTP_STATUS" "$output" ;;
  esac
}

format_me() {
  python3 - "$1" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    data = json.load(handle)
user = data.get("user") or {}
name = user.get("name") or user.get("github_login") or user.get("email") or "unknown user"
email = user.get("email") or ""
if email and email != name:
    print(f"Authenticated as {name} <{email}>")
else:
    print(f"Authenticated as {name}")

memberships = data.get("memberships") or []
if memberships:
    print("Workspaces:")
    for membership in memberships:
        slug = membership.get("workspace_slug") or membership.get("slug") or "?"
        workspace_name = membership.get("workspace_name") or membership.get("name") or ""
        role = membership.get("role") or "member"
        label = f"{slug} ({role})"
        if workspace_name and workspace_name != slug:
            label = f"{workspace_name} [{label}]"
        print(f"  {label}")
PY
}

current_user_id() {
  local me_file="$TMP_DIR/me.json"
  request GET "$API_ROOT/me" "$me_file"
  python3 - "$me_file" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    data = json.load(handle)
user = data.get("user") or {}
user_id = user.get("id")
if not user_id:
    print("velvet: GET /me did not return user.id", file=sys.stderr)
    raise SystemExit(1)
print(user_id)
PY
}

format_issues() {
  python3 - "$1" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    data = json.load(handle)
issues = data.get("issues") if isinstance(data, dict) else data
if not isinstance(issues, list):
    raise SystemExit("velvet: unexpected issue list response")
if not issues:
    print("No issues found.")
    raise SystemExit(0)
for issue in issues:
    key = str(issue.get("key") or "?")
    title = str(issue.get("title") or "").replace("\t", " ").replace("\r", " ").replace("\n", " ")
    print(f"{key}\t{title}")
PY
}

format_issue() {
  python3 - "$1" "$2" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    issue = json.load(handle)
with open(sys.argv[2], encoding="utf-8") as handle:
    comment_data = json.load(handle)

key = issue.get("key") or "?"
title = issue.get("title") or ""
print(f"{key}: {title}")
print(f"Status: {issue.get('status') or '?'}")
print(f"Priority: {issue.get('priority', '?')}")
if issue.get("assignee_id"):
    print(f"Assignee: {issue['assignee_id']}")
if issue.get("milestone_id"):
    print(f"Milestone: {issue['milestone_id']}")
description = issue.get("description") or ""
if description:
    print("Description:")
    print(description)

comments = comment_data.get("comments") if isinstance(comment_data, dict) else []
if not isinstance(comments, list):
    comments = []
print("Recent comments:")
if not comments:
    print("  (none)")

for comment in comments[-10:]:
    def emit(item, indent):
        author = item.get("author") or {}
        author_name = author.get("name") or author.get("github_login") or author.get("email") or "unknown user"
        created = item.get("created_at") or ""
        stamp = f" ({created})" if created else ""
        print(f"{indent}- {author_name}{stamp}")
        body = item.get("body") or ""
        for line in body.splitlines() or [""]:
            print(f"{indent}  {line}")
        for reply in item.get("replies") or []:
            emit(reply, indent + "  ")
    emit(comment, "  ")
PY
}

new_payload() {
  python3 - "$@" <<'PY'
import json
import sys

# argv: title, has_desc, desc, has_status, status, has_priority, priority,
#       has_milestone, milestone
payload = {"title": sys.argv[1]}
if sys.argv[2] == "1":
    payload["description"] = sys.argv[3]
if sys.argv[4] == "1":
    payload["status"] = sys.argv[5]
if sys.argv[6] == "1":
    payload["priority"] = int(sys.argv[7])
if sys.argv[8] == "1":
    payload["milestone_id"] = sys.argv[9]
print(json.dumps(payload, separators=(",", ":")))
PY
}

comment_payload() {
  python3 - "$1" <<'PY'
import json
import sys

print(json.dumps({"body": sys.argv[1]}, separators=(",", ":")))
PY
}

status_payload() {
  python3 - "$1" <<'PY'
import json
import sys

print(json.dumps({"status": sys.argv[1]}, separators=(",", ":")))
PY
}

command_me() {
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    [ "$#" -eq 1 ] || die "me does not accept additional arguments" "$EX_USAGE"
    usage_me
    return 0
  fi
  [ "$#" -eq 0 ] || die "me does not accept arguments; run 'velvet me --help'" "$EX_USAGE"
  require_base_config
  request GET "$API_ROOT/me" "$TMP_DIR/me.json"
  format_me "$TMP_DIR/me.json"
}

command_issues() {
  local status_filter=""
  local mine=0
  local user_id
  local workspace_path
  local url
  local query=""
  local param

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --help|-h)
        [ "$#" -eq 1 ] || die "issues --help does not accept additional arguments" "$EX_USAGE"
        usage_issues
        return 0
        ;;
      --status)
        shift
        [ "$#" -gt 0 ] || die "--status requires a value" "$EX_USAGE"
        status_filter=$1
        ;;
      --status=*)
        status_filter=${1#*=}
        ;;
      --mine)
        mine=1
        ;;
      *)
        die "unknown issues option: $1" "$EX_USAGE"
        ;;
    esac
    shift
  done

  if [ -n "$status_filter" ] && ! valid_status "$status_filter"; then
    die "invalid status '$status_filter'; use backlog, todo, in_progress, in_review, done, or cancelled" "$EX_USAGE"
  fi

  require_workspace
  workspace_path=$(urlencode "$VELVET_WORKSPACE")
  url="$API_ROOT/w/$workspace_path/issues"
  if [ -n "$status_filter" ]; then
    query=$(query_param status "$status_filter")
  fi
  if [ "$mine" -eq 1 ]; then
    user_id=$(current_user_id)
    param=$(query_param assignee_id "$user_id")
    if [ -n "$query" ]; then
      query="$query&$param"
    else
      query=$param
    fi
  fi
  if [ -n "$query" ]; then
    url="$url?$query"
  fi
  request GET "$url" "$TMP_DIR/issues.json"
  format_issues "$TMP_DIR/issues.json"
}

command_issue() {
  local key
  local key_path
  local workspace_path
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    [ "$#" -eq 1 ] || die "issue --help does not accept additional arguments" "$EX_USAGE"
    usage_issue
    return 0
  fi
  [ "$#" -eq 1 ] || die "issue requires exactly one issue key; run 'velvet issue --help'" "$EX_USAGE"
  key=$1
  require_workspace
  workspace_path=$(urlencode "$VELVET_WORKSPACE")
  key_path=$(urlencode "$key")
  request GET "$API_ROOT/w/$workspace_path/issues/$key_path" "$TMP_DIR/issue.json"
  request GET "$API_ROOT/w/$workspace_path/issues/$key_path/comments" "$TMP_DIR/comments.json"
  format_issue "$TMP_DIR/issue.json" "$TMP_DIR/comments.json"
}

command_new() {
  local title=""
  local description=""
  local status_value=""
  local priority=""
  local milestone=""
  local has_description=0
  local has_status=0
  local has_priority=0
  local has_milestone=0
  local workspace_path
  local payload
  local key

  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    [ "$#" -eq 1 ] || die "new --help does not accept additional arguments" "$EX_USAGE"
    usage_new
    return 0
  fi
  [ "$#" -gt 0 ] || die "new requires a title; run 'velvet new --help'" "$EX_USAGE"
  title=$1
  shift

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --help|-h)
        [ "$#" -eq 1 ] || die "new --help does not accept additional arguments" "$EX_USAGE"
        usage_new
        return 0
        ;;
      --desc)
        shift
        [ "$#" -gt 0 ] || die "--desc requires a value" "$EX_USAGE"
        description=$1
        has_description=1
        ;;
      --desc=*)
        description=${1#*=}
        has_description=1
        ;;
      --status)
        shift
        [ "$#" -gt 0 ] || die "--status requires a value" "$EX_USAGE"
        status_value=$1
        has_status=1
        ;;
      --status=*)
        status_value=${1#*=}
        has_status=1
        ;;
      --priority)
        shift
        [ "$#" -gt 0 ] || die "--priority requires a value" "$EX_USAGE"
        priority=$1
        has_priority=1
        ;;
      --priority=*)
        priority=${1#*=}
        has_priority=1
        ;;
      --milestone)
        shift
        [ "$#" -gt 0 ] || die "--milestone requires a value" "$EX_USAGE"
        milestone=$1
        has_milestone=1
        ;;
      --milestone=*)
        milestone=${1#*=}
        has_milestone=1
        ;;
      *)
        die "unknown new option: $1" "$EX_USAGE"
        ;;
    esac
    shift
  done

  if [ "$has_status" -eq 1 ] && ! valid_status "$status_value"; then
    die "invalid status '$status_value'; use backlog, todo, in_progress, in_review, done, or cancelled" "$EX_USAGE"
  fi
  if [ "$has_priority" -eq 1 ]; then
    case "$priority" in
      ''|*[!0-9]*) die "priority must be an integer from 0 through 4" "$EX_USAGE" ;;
    esac
    if [ "$priority" -gt 4 ]; then
      die "priority must be an integer from 0 through 4" "$EX_USAGE"
    fi
  fi

  require_workspace
  workspace_path=$(urlencode "$VELVET_WORKSPACE")
  payload=$(new_payload "$title" "$has_description" "$description" "$has_status" "$status_value" "$has_priority" "$priority" "$has_milestone" "$milestone")
  request POST "$API_ROOT/w/$workspace_path/issues" "$TMP_DIR/new.json" "$payload"
  key=$(python3 - "$TMP_DIR/new.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    issue = json.load(handle)
key = issue.get("key")
if not key:
    print("velvet: create response did not include issue.key", file=sys.stderr)
    raise SystemExit(1)
print(key)
PY
  )
  printf '%s\n' "$key"
}

command_log() {
  local key
  local body
  local workspace_path
  local key_path
  local payload

  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    [ "$#" -eq 1 ] || die "log --help does not accept additional arguments" "$EX_USAGE"
    usage_log
    return 0
  fi
  [ "$#" -gt 0 ] || die "log requires an issue key; run 'velvet log --help'" "$EX_USAGE"
  key=$1
  shift
  if [ "$#" -gt 0 ]; then
    body=$*
  else
    body=$(cat)
  fi
  [ -n "$body" ] || die "log body is empty; pass BODY or pipe the note on stdin" "$EX_USAGE"

  require_workspace
  workspace_path=$(urlencode "$VELVET_WORKSPACE")
  key_path=$(urlencode "$key")
  payload=$(comment_payload "$body")
  request POST "$API_ROOT/w/$workspace_path/issues/$key_path/comments" "$TMP_DIR/comment.json" "$payload"
  printf 'Logged worklog to %s.\n' "$key"
}

command_status() {
  local key
  local status_value
  local workspace_path
  local key_path
  local payload

  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    [ "$#" -eq 1 ] || die "status --help does not accept additional arguments" "$EX_USAGE"
    usage_status
    return 0
  fi
  [ "$#" -eq 2 ] || die "status requires KEY and STATUS; run 'velvet status --help'" "$EX_USAGE"
  key=$1
  status_value=$2
  if ! valid_status "$status_value"; then
    die "invalid status '$status_value'; use backlog, todo, in_progress, in_review, done, or cancelled" "$EX_USAGE"
  fi

  require_workspace
  workspace_path=$(urlencode "$VELVET_WORKSPACE")
  key_path=$(urlencode "$key")
  payload=$(status_payload "$status_value")
  request PATCH "$API_ROOT/w/$workspace_path/issues/$key_path" "$TMP_DIR/status.json" "$payload"
  printf '%s: %s\n' "$key" "$status_value"
}

command_key_from_branch() {
  local branch
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    [ "$#" -eq 1 ] || die "key-from-branch --help does not accept additional arguments" "$EX_USAGE"
    usage_key_from_branch
    return 0
  fi
  require_command git
  [ "$#" -eq 0 ] || die "key-from-branch does not accept arguments" "$EX_USAGE"
  if ! branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null); then
    printf 'velvet: no issue key found because HEAD is detached\n' >&2
    return 1
  fi
  if ! python3 - "$branch" <<'PY'
import re
import sys

branch = sys.argv[1]
match = re.search(r"(?<![A-Za-z0-9])([A-Za-z][A-Za-z0-9]*-[0-9]+)(?![A-Za-z0-9])", branch)
if not match:
    raise SystemExit(1)
print(match.group(1).upper())
PY
  then
    printf 'velvet: no issue key found in branch %s\n' "$branch" >&2
    return 1
  fi
}

show_help_command() {
  case "${1:-}" in
    "") usage ;;
    me) usage_me ;;
    issues) usage_issues ;;
    issue) usage_issue ;;
    new) usage_new ;;
    log) usage_log ;;
    status) usage_status ;;
    key-from-branch) usage_key_from_branch ;;
    *) die "unknown command '$1'" "$EX_USAGE" ;;
  esac
}

main() {
  local command=${1:-}
  if [ "$#" -gt 0 ]; then
    shift
  fi
  case "$command" in
    ""|help|-h|--help)
      if [ "$command" = "help" ] || [ "$command" = "-h" ] || [ "$command" = "--help" ]; then
        [ "$#" -le 1 ] || die "help accepts at most one command" "$EX_USAGE"
        show_help_command "${1:-}"
      else
        usage
      fi
      ;;
    me) command_me "$@" ;;
    issues) command_issues "$@" ;;
    issue) command_issue "$@" ;;
    new) command_new "$@" ;;
    log) command_log "$@" ;;
    status) command_status "$@" ;;
    key-from-branch) command_key_from_branch "$@" ;;
    *) die "unknown command '$command'; run 'velvet --help'" "$EX_USAGE" ;;
  esac
}

main "$@"
